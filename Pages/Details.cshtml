@page
@model Project.Pages.DetailsModel
@{
    ViewData["Title"] = "Album Details";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <div class="card shadow-sm col-md-8 offset-md-2">
        <div class="card-header bg-info text-white">
            <h2 class="mb-0">Album Details</h2>
        </div>
        <div class="card-body">
            <h3>@Model.Album.Title</h3>
            <p class="lead"><strong>Artist:</strong> @Model.Artist?.Name</p>
            <hr />
            <h5 class="mb-3">Tracks in this album:</h5>
            @if (Model.Tracks != null && Model.Tracks.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach(var track in Model.Tracks) 
                    {
                        <li class="list-group-item">@track.Name</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted italic">No tracks found for this album.</p>
            }
            
            <div class="mt-4 border-top pt-3">
                <a href="/Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>