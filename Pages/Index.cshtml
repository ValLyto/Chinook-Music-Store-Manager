@page
@model Project.Pages.IndexModel
@{
    ViewData["Title"] = "Chinook Album Manager";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h1 class="mb-1">Chinook Album Manager</h1>
    <h4 class="text-muted mb-4">
        Name: @Model.StudentName | Banner ID: @Model.BannerId
    </h4>

    <form method="get" class="row g-2 mb-3">
        <div class="col-sm-8 col-md-6">
            <input type="text"
                   name="SearchString"
                   value="@Model.SearchString"
                   class="form-control"
                   placeholder="Search by album title or artist..." />
        </div>
        <div class="col-sm-4 col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </form>

    <div class="mb-3">
        <a href="/Insert" class="btn btn-success">Insert New Album</a>
    </div>

    @if (Model.Albums != null && Model.Albums.Count > 0)
    {
        <table class="table table-striped table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Artist</th>
                    <th class="text-center">Tracks</th>
                    <th style="width: 250px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Albums)
                {
                    <tr>
                        <td>@a.Title</td>
                        <td>@a.ArtistName</td>
                        <td class="text-center">@a.TrackCount</td>
                        <td class="text-center">
                            <a href="/Details?id=@a.AlbumId" class="btn btn-sm btn-info">Details</a>
                            <a href="/Update?id=@a.AlbumId" class="btn btn-sm btn-warning">Update</a>
                            <a href="/Delete?id=@a.AlbumId" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning">
            No albums found. Try a different search term.
        </div>
    }
</div>