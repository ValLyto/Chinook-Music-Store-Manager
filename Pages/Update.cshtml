@page
@model Project.Pages.UpdateModel
@{
    ViewData["Title"] = "Update Album Details";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="card shadow col-md-8 offset-md-2">
        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">Update Album Details</h3>
        </div>
        <div class="card-body">
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    Please correct the errors below.
                </div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                
                <input type="hidden" name="id" value="@Model.Album.AlbumId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Album Title:</label>
                    <input type="text" name="Title" class="form-control" 
                           value="@Model.Album.Title" required maxlength="160" />
                    <div class="form-text">Max 160 characters.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Select Artist:</label>
                    <select name="ArtistId" class="form-select" required>
                        @foreach (var artist in Model.Artists)
                        {
                            <option value="@artist.Value" 
                                    selected="@(artist.Value == Model.Album.ArtistId.ToString())">
                                @artist.Text
                            </option>
                        }
                    </select>
                </div>

                <hr />
                <h5>Tracks:</h5>
                @if (Model.Tracks != null && Model.Tracks.Any())
                {
                    <div class="list-group mb-4">
                        @foreach (var track in Model.Tracks)
                        {
                            <div class="list-group-item d-flex align-items-center">
                                <span class="fw-bold me-3">#@track.TrackId</span>
                                <input type="text" name="Track_@track.TrackId" class="form-control" value="@track.Name" required />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted italic">No tracks found for this album.</p>
                }

                <div class="d-flex justify-content-between border-top pt-3">
                    <a href="/Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>