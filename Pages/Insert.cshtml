@page
@model Project.Pages.InsertModel
@{
    ViewData["Title"] = "Insert New Album";
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container mt-5">
    <div class="card shadow col-md-8 offset-md-2">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Chinook Music Store: Insert</h3>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            <form method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label class="form-label">Album Title:</label>
                    <input type="text" name="Title" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Artist:</label>
                    <select name="ArtistId" class="form-select" required>
                        <option value="">-- Select Artist --</option>
                        @foreach (var artist in Model.Artists)
                        {
                            <option value="@artist.Value">@artist.Text</option>
                        }
                    </select>
                </div>

                <hr />
                <h5>Tracks:</h5>
                <div id="trackContainer">
                    <div class="input-group mb-2">
                        <span class="input-group-text">Track 1</span>
                        <input type="text" name="TrackNames" class="form-control" placeholder="Song name">
                    </div>
                </div>

                <button type="button" class="btn btn-sm btn-outline-secondary mb-3" onclick="addTrackField()">
                    + Add another track
                </button>

                <div class="mt-3 border-top pt-3 text-end">
                    <a href="/Index" class="btn btn-link">Back</a>
                    <button type="submit" class="btn btn-success px-4">Save Everything</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let trackCount = 1;
    function addTrackField() {
        trackCount++;
        const container = document.getElementById('trackContainer');
        const div = document.createElement('div');
        div.className = 'input-group mb-2';
        div.innerHTML = `
            <span class="input-group-text">Track ${trackCount}</span>
            <input type="text" name="TrackNames" class="form-control" placeholder="Song name">
        `;
        container.appendChild(div);
    }
</script>
</body>
</html>