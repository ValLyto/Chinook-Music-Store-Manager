@page
@model Project.Pages.DeleteModel
@{
    ViewData["Title"] = "Delete Album";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="card border-danger shadow-sm col-md-6 offset-md-3">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Confirmation</h3>
        </div>
        <div class="card-body">
            <p>Are you sure you want to delete the album: <strong>@Model.Album.Title</strong>?</p>
            <p class="text-muted small">Note: All associated tracks will also be removed.</p>
            
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Album.AlbumId" />
                
                <div class="mt-4">
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    <a href="/Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>